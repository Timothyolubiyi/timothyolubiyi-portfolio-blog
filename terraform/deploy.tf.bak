################################################################################
# Upload Static Website Files
################################################################################

locals {
  website_path = "${path.module}/../dist"

  website_files = fileset(local.website_path, "**")

  mime_types = {
    html = "text/html"
    css  = "text/css"
    js   = "application/javascript"
    json = "application/json"
    map  = "application/json"

    png  = "image/png"
    jpg  = "image/jpeg"
    jpeg = "image/jpeg"
    gif  = "image/gif"
    svg  = "image/svg+xml"
    ico  = "image/x-icon"
    webp = "image/webp"

    txt = "text/plain"
    xml = "application/xml"

    pdf = "application/pdf"

    woff  = "font/woff"
    woff2 = "font/woff2"
    ttf   = "font/ttf"
    eot   = "application/vnd.ms-fontobject"

    mp4 = "video/mp4"

    zip = "application/zip"
  }
}

################################################################################
# Upload Website
################################################################################

resource "aws_s3_object" "website" {

  for_each = local.website_files

  bucket = aws_s3_bucket.portfolio.id

  key = each.value

  source = "${local.website_path}/${each.value}"

  etag = filemd5("${local.website_path}/${each.value}")

  content_type = lookup(
    local.mime_types,
    lower(element(reverse(split(".", each.value)), 0)),
    "application/octet-stream"
  )

  server_side_encryption = "AES256"
}

################################################################################
# CloudFront Cache Invalidation
################################################################################

resource "null_resource" "cloudfront_invalidation" {

  triggers = {
    files = sha256(join("", [
      for f in local.website_files :
      filesha256("${local.website_path}/${f}")
    ]))
  }

  depends_on = [
    aws_s3_object.website
  ]

  provisioner "local-exec" {
  interpreter = ["C:/Program Files/Git/bin/bash.exe", "-c"]

  command = <<EOF
aws cloudfront create-invalidation \
  --distribution-id ${aws_cloudfront_distribution.portfolio.id} \
  --paths '/*'
EOF
}
}